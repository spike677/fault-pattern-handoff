{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MECH-v0.5/development-mode",
  "title": "New MECH-v0.5 knowledge definition (inherited v0.4 cards retain their original schema)",
  "type": "object",
  "required": ["version", "parent", "title", "definition", "definition_level", "knowledge_status", "classification_enabled", "source_ids", "wrong_action", "correct_contract", "failed_relation", "operation_fact", "necessary", "excluded_by", "exclusions", "test_design", "source_cards", "representative_cases", "validation_limit"],
  "properties": {
    "version": {"const": "0.5"},
    "parent": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "definition_level": {"enum": ["implementation_error", "mechanism_relation"]},
    "knowledge_status": {"enum": ["reviewed_definition", "research_definition"]},
    "classification_enabled": {"type": "boolean"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "wrong_action": {"type": "string", "minLength": 1},
    "correct_contract": {"type": "string", "minLength": 1},
    "failed_relation": {"type": "string", "minLength": 1},
    "operation_fact": {"type": "string", "minLength": 1},
    "necessary": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "excluded_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "exclusions": {"type": "array", "minItems": 1},
    "test_design": {"type": "object", "required": ["positive", "negative", "decisive_observation"]},
    "source_cards": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "representative_cases": {"type": "array"}
  },
  "allOf": [
    {"if": {"properties": {"classification_enabled": {"const": true}}}, "then": {"properties": {"knowledge_status": {"const": "reviewed_definition"}}}}
  ]
}
