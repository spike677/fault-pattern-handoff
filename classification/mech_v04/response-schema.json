          "case_id": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            },
            "minItems": 1
          },
          "readback": {
            "type": "string"
          },
          "supporting_operations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/supporting_operation"
            }
          }
        },
        "required": [
          "case_id",
          "operator",
          "roles",
          "actions",
          "readback",
          "supporting_operations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false,
