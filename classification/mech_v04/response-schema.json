      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "independent",
            "downstream",
            "unknown"
          ]
        },
        "upstream_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string"
            },
            "claim": {
              "enum": [
                "static",
                "reported",
                "runtime"
              ]
            },
            "build": {
              "type": [
                "string",
                "null"
              ]
            },
            "call_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "source_id",
            "claim",
            "build",
            "call_id"
          ],
          "additionalProperties": false
        },
        "facts": {
