            "contribution_neutralized",
            "contribution_preserved",
            "contribution_violation",
            "correct_contiguous_conversion",
            "correct_source",
            "distinct_members_for_replacement",
            "equivalent_source",
            "established_other_defect",
            "excess_multiplicity",
            "expected_multiplicity",
            "expected_multiplicity_met",
            "expected_source",
            "expected_units",
            "implementation_action",
            "ineligible_member",
            "member_eligible",
            "multiplicity_violation",
            "no_correct_contiguous_conversion",
            "non_equivalent_source",
            "omission_permitted",
            "omitted_contribution",
            "original_contribution_identity",
            "parameter_violation",
            "participation_violation",
            "repeat_semantics_permitted",
            "required_member",
            "special_state",
            "state_treatment_allowed",
            "storage_width",
            "supported_view",
            "view_formula_correct",
            "view_unsupported",
            "wrong_conversion",
            "wrong_state_treatment",
            "centered_variance_survives_at_same_precision",
            "contribution_set_preserved",
            "distorted_value_consumed",
            "loop_carried_narrow_state",
            "pre_reduction_square_overflow",
            "variance_consumed_by_normalization",
            "variance_from_raw_moment_difference",
            "wider_state_preserves_same_updates"
